# Architectural boundaries, enforced by import-linter (`uv run lint-imports`).
#
# The packages below are deliberately empty in the walking skeleton: the contract is
# live from the first commit, so the first module that lands in the wrong layer fails
# CI instead of quietly setting a precedent.
[importlinter]
root_package = portfolio
include_external_packages = True

[importlinter:contract:portfolio]
name = portfolio
type = layers
# `portfolio.config` is a layer rather than a module nothing constrains. It reads the
# environment, and it sits directly above `portfolio.domain` so that the one direction that
# matters is impossible: a `domain` module doing `from portfolio.config import get_settings`
# would put an environment read inside the layer whose entire property is that it has none.
# Every existing edge is downward and stays legal -- `api`, `cli` and `db.migrations.env`
# read settings, and `config` reads the password policy from `domain` so that the bootstrap
# password is measured against the same rule as every other password.
#
# `portfolio.cli` sits beside `portfolio.api` rather than above it: they are two entry
# points onto the same services, and neither may import the other. A CLI that reached into
# the API layer would drag FastAPI into an operator command, and an API that reached into
# the CLI would inherit its `getpass` prompt.
#
# Items on one line are independent: siblings may not import each other. `portfolio.db`
# and `portfolio.domain` were on one line, which made `db -> domain` a violation -- and
# that is the import the money types need, so that `NumericText` rounds by the rule
# `domain.money` defines instead of carrying a second copy of it. `db` therefore sits
# above `domain`. `domain` still imports nothing from the application, which is the
# property that actually matters; persistence depending on the domain vocabulary is the
# right direction, and the reverse would not be.
layers =
    portfolio.cli | portfolio.api
    portfolio.services
    portfolio.repositories | portfolio.providers
    portfolio.db
    portfolio.config
    portfolio.domain

[importlinter:contract:thin-routers]
name = portfolio routers stay thin
type = forbidden
# Direct imports only. Rule 4 is "a router may not import a repository, a provider,
# sqlalchemy or httpx" -- it is about what a router reaches for, not about what its
# service reaches for on its way to the database. Without this flag the contract also
# reports the chain `router -> service -> repository`, which is the layering working
# exactly as intended, and it would fail for the first router that ever called a service.
# The layers contract above is what keeps the chain pointing downward.
allow_indirect_imports = True
source_modules =
    portfolio.api.routers
forbidden_modules =
    sqlalchemy
    httpx
    portfolio.repositories
    portfolio.providers

[importlinter:contract:framework-free-services]
name = portfolio services stay framework free
type = forbidden
source_modules =
    portfolio.services
forbidden_modules =
    fastapi

[importlinter:contract:prices-are-never-fetched-in-a-request]
name = no request path reaches a price provider
# Criterion 2 of #9, as a statement about the import graph rather than a unit test.
#
# **Deliberately without `allow_indirect_imports`**, unlike the thin-routers contract above.
# Here the chain `router -> service -> price provider` is exactly the violation worth
# catching, because it is the one a well-meaning change introduces: somebody adds "just
# refresh it if it is stale" to the valuation service, and every dashboard render becomes a
# third-party call. A direct-only check would pass that change without a word.
#
# The reason is not the quota. Measured on 2026-09-23, the key-free primary answers every
# configured pair in one call, so an hourly refresh costs 720 requests a month. The reason
# is that a request path calling a vendor inherits that vendor's latency and its outages.
#
# **This contract passes vacuously until `portfolio.providers.prices` exists**, which is the
# failure mode this repository keeps finding: a guard whose subject is missing reports
# success. `import-linter` does not complain about a forbidden module it cannot see. What
# keeps it honest is not its presence but the test that plants a violating module and asserts
# this contract reports it -- the same shape as the `mypy` conformance check in
# `tests/providers/test_protocol.py`.
#
# **The vacuity moved rather than closed.** `portfolio.providers.prices` now exists, so the
# forbidden end is real -- but no router imports any price service yet, so the chain this
# contract describes cannot exist at either end until #11 lands the valuation endpoint. What
# the service split in #9 bought is that when that endpoint arrives, the contract will still
# be able to fail: `services/prices.py` is provider-free, so a future "just refresh it if it
# is stale" is a *new* edge rather than one that was always there.
#
# **Since #11 the source end is real too.** `api/routers/balances.py` reaches
# `services.prices` through `services.balances`, and the contract holds because
# `services/prices.py` still imports no provider.
type = forbidden
source_modules =
    portfolio.api.routers
forbidden_modules =
    portfolio.providers.prices

[importlinter:contract:domain-is-pure]
name = portfolio domain is pure
# Criterion 1 of #17: `portfolio.domain` does no I/O and has no source of nondeterminism,
# so that everything here is a function of its arguments and nothing else. The `layers` contract above already stops `domain` importing
# the application; this contract is about what it may not import from *outside* it.
#
# **Two halves.** The frameworks and clients (`sqlalchemy`, `httpx`, `fastapi`, `starlette`,
# `pydantic`), and the standard-library modules that do I/O or introduce nondeterminism.
# Naming a stdlib module here works because `include_external_packages = True` above makes
# grimp add every top-level package an application module imports -- the standard library
# included -- to the graph as one squashed node, so `from urllib import parse` arrives as an
# import of `urllib`. Measured with import-linter 2.15 and grimp 3.17 by planting
# `import os`, `import socket`, `import time`, `from urllib import parse`, `import logging`,
# `import http.client` and `import sqlalchemy` in a domain module of a shadow copy of the
# package: each was reported BROKEN, by its top-level name, and without them the contract
# was KEPT. `logging` and `http` resolve to the standard library rather than to
# `portfolio.logging` or `portfolio.providers.http`, because an absolute import is. Only
# top-level names are accepted (`os`, never `os.path`); import-linter refuses a submodule of
# an external package with a configuration error rather than ignoring it.
#
# **The second twelve, from `zoneinfo` on, were added at review**, and each is here for the
# same two reasons as the first sixteen:
#
# * `zoneinfo` reads the host's time-zone database from disk, and its answer for one instant
#   changes with the tzdata release installed. An event key is UTC and needs neither.
# * `tempfile`, `shutil` and `glob` are the filesystem, by other names than `os` and
#   `pathlib`.
# * `multiprocessing` and `concurrent` run work in other processes and threads, where the
#   order things finish in is the scheduler's rather than the input's.
# * `ctypes` calls native code, which can do anything at all.
# * `signal`, `select` and `selectors` are the operating system's signals and I/O waits.
# * `platform` describes the host it runs on, so an answer built on it differs by machine.
# * `locale` is process-wide state that changes how numbers format and strings collate, so a
#   result built on it differs by the host's settings rather than by the events.
#
# Planted together in a shadow domain module, `from concurrent import futures` included, all
# twelve were reported BROKEN by their top-level names, as the first batch was. Criterion 1
# of spec 019 lists all thirty-three. Builtins that do I/O without any import -- `open`,
# `print`, `input` -- and an argument-less `astimezone()`, which reads the host's zone, are
# beyond what an import contract can see; they are for the AST test in `tests/security/` to
# forbid, beside the clock calls.
#
# **Vacuous per module until something imports it**, and that is inherent rather than a
# gap: import-linter checks only the forbidden modules that are in the graph, and an
# external module enters the graph when any application module imports it. `socket` is in
# no graph until somebody writes `import socket`, and that is exactly the edit this contract
# then reports. What proves the harness can see such an edit at all is the planted-violation
# test in `tests/test_import_contracts.py`.
#
# **The clock is not here, because it is a call, not an import.** `datetime` is needed for
# an event's key, and `datetime.now()` needs nothing more; `tests/security/` forbids the
# calls with an AST test instead. `hashlib` is deliberately absent too: SHA-256 is a pure
# function.
#
# **Deliberately without `allow_indirect_imports`**, and what that does and does not buy
# was measured rather than assumed. The source is the whole `portfolio.domain` package, so
# imports between domain modules collapse into one node: in a chain `domain.a -> domain.b
# -> socket` only `domain.b -> socket` is reported, with the flag or without it. The flag
# matters for a chain that *leaves* the package. With a planted `domain.caller ->
# portfolio.outside -> socket`, this contract reports the whole chain as it stands, and
# with the flag added it is KEPT. `domain` importing the application at all is the layers
# contract's to refuse, but a module that sits in no layer is one that contract does not
# constrain, and this one still sees through it.
type = forbidden
source_modules =
    portfolio.domain
forbidden_modules =
    sqlalchemy
    httpx
    fastapi
    starlette
    pydantic
    os
    io
    pathlib
    socket
    ssl
    subprocess
    urllib
    http
    sqlite3
    asyncio
    threading
    time
    random
    secrets
    uuid
    logging
    zoneinfo
    tempfile
    shutil
    glob
    multiprocessing
    concurrent
    ctypes
    signal
    select
    selectors
    platform
    locale
